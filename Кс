document.getElementById('sens').oninput=e=>{sens=+e.target.value;document.getElementById('sensVal').textContent=sens.toFixed(1);};
document.getElementById('assist').onchange=e=>assist=e.target.checked;
document.getElementById('autofire').onchange=e=>autofire=e.target.checked;

/* ============ ЦИКЛ ============ */
let last=performance.now();
function loop(now){
  let dt=Math.min(.05,(now-last)/1000);last=now;
  if(state==='play'){
    roundT+=dt;
    // ввод движения
    let mf=0,ms=0;
    if(keys.KeyW)mf+=1; if(keys.KeyS)mf-=1; if(keys.KeyD)ms+=1; if(keys.KeyA)ms-=1;
    if(keys.ArrowLeft)P.ang-=2*dt; if(keys.ArrowRight)P.ang+=2*dt;
    mf-=joy.dy; ms+=joy.dx;
    const crouching=(P.crouchHold||keys.ControlLeft)?1:0;
    P.crouch+=((crouching?1:0)-P.crouch)*Math.min(1,dt*10);
    const len=Math.hypot(mf,ms)||1, mag=Math.min(1,Math.hypot(mf,ms));
    const speed=(3.3-P.crouch*1.8)*(P.zoom?.5:1);
    if(mag>.08&&P.alive){
      const fx=Math.cos(P.ang),fy=Math.sin(P.ang);
      const vx=(fx*mf/len+(-fy)*ms/len)*speed*mag*dt;
      const vy=(fy*mf/len+(fx)*ms/len)*speed*mag*dt;
      move(P,vx,vy,.22);
      P.bob+=dt*9*mag;
    } else P.bob+=dt*1.5;
    // автоогонь
    if(firing&&(autofire||W[P.cur].auto)&&W[P.cur].auto)playerShoot();
    else if(firing&&autofire&&!W[P.cur].auto&&P.fireT<=0)playerShoot();
    // таймеры
    P.fireT=Math.max(0,P.fireT-dt);
    P.kick=Math.max(0,P.kick-dt*0.55);
    P.recoil=Math.max(0,P.recoil-dt*1.6);
    if(P.reloadT>0){P.reloadT-=dt;
      if(P.reloadT<=0){const w=W[P.cur],inv=P.inv[P.cur];
        const need=w.mag-inv.m,take=Math.min(need,inv.r);inv.m+=take;inv.r-=take;updHUD();}}
    updBots(dt);
    // частицы
    for(let i=parts.length-1;i>=0;i--){const p=parts[i];
      p.l-=dt;p.vz-=4*dt;p.x+=p.vx*dt;p.y+=p.vy*dt;p.z+=p.vz*dt;
      if(p.l<=0||p.z<0)parts.splice(i,1);}
    for(let i=flashes.length-1;i>=0;i--){flashes[i].t-=dt;if(flashes[i].t<=0)flashes.splice(i,1);}
  }
  if(state!=='menu'){render();drawMini();}
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);
updHUD();
</script>
